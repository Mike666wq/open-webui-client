{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open WebUI Client",
  "version": "0.2.14",
  "identifier": "local.openwebui.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "local-shell"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Open WebUI Client",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "useHttpsScheme": false,
        "url": "index.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "android": {
      "minSdkVersion": 29,
      "versionCode": 2
    }
  }
}
